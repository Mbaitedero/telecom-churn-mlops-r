# Copie ce fichier en .env puis remplace les mots de passe (voir commandes plus bas).
# .env est ignoré par Git : ne le committe jamais.

# Base de données (compte propriétaire : migrations uniquement)
POSTGRES_DB=telecom_platform
POSTGRES_USER=telecom_owner
POSTGRES_PASSWORD=change_me

# Compte applicatif (utilisé par l'API à partir de la Phase C : droits limités)
APP_DB_USER=telecom_app
APP_DB_PASSWORD=change_me

# Réseau : 127.0.0.1 = accessible seulement depuis ta machine
BIND_ADDRESS=127.0.0.1
API_PORT=8000
APP_PORT=3838
DB_PORT=5432
